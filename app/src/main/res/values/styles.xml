<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TheSystem" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#090A0C</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#D9D9D6</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="WidgetStatus">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#50575E</item>
        <item name="android:textSize">11sp</item>
    </style>

</resources>
