<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_hse"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/hse_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#C6D2F2"
            android:textSize="10sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="РЕЖИМ ВШЭ"
            android:textColor="#C6D2F2"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/hse_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="ПАРА 09:30 · ВЫХОД 08:45"
            android:textColor="#838B9F"
            android:textSize="9sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/hse_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:maxLines="1"
        android:text="До выхода 1 ч 15 мин"
        android:textColor="#F1F3F8"
        android:textSize="24sp" />
    <TextView
        android:id="@+id/hse_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_surface"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:text="Закрыть лабораторную"
        android:textColor="#C7CBD5"
        android:textSize="11sp" />
</LinearLayout>
